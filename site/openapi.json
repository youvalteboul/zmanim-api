{
  "openapi": "3.1.0",
  "info": {
    "title": "Zmanim API",
    "version": "1.0.0",
    "summary": "Horaires juifs réglables avis par avis, en JSON.",
    "description": "Zmanim selon les règles de CalJ (Or Méïr · Rav Posen), Rav Ovadia Yossef ou hebcal, et n'importe quel avis libre ; date hébraïque, fêtes (diaspora et Israël), paracha, allumage, jeûnes, tefila du jour et offices. Mêmes calculs dans Node, dans un navigateur (hors ligne) ou par cette API HTTP."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "npm start"
    }
  ],
  "tags": [
    {
      "name": "Horaires"
    },
    {
      "name": "Catalogues"
    }
  ],
  "paths": {
    "/horaires": {
      "get": {
        "tags": [
          "Horaires"
        ],
        "operationId": "horaires",
        "summary": "Horaires d'un ou plusieurs jours",
        "description": "Toutes les options en paramètres. `ajouts` et `offices` se passent en JSON encodé, ou par POST.",
        "parameters": [
          {
            "name": "lieu",
            "in": "query",
            "required": false,
            "description": "Ville, ou « lat,lon ».",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "description": "Fuseau IANA.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "AAAA-MM-JJ.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-11-13"
          },
          {
            "name": "jours",
            "in": "query",
            "required": false,
            "description": "Nombre de jours.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 366
            },
            "example": 7
          },
          {
            "name": "minhag",
            "in": "query",
            "required": false,
            "description": "Pré-réglage des avis.",
            "schema": {
              "type": "string",
              "enum": [
                "ormeir",
                "ovadia",
                "standard"
              ]
            }
          },
          {
            "name": "alot",
            "in": "query",
            "required": false,
            "description": "Code proposé (16.1, 72p, 90p, 72f, 19.8) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») avant le netz.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "misheyakir",
            "in": "query",
            "required": false,
            "description": "Code proposé (11, 11.5, 10.2, 6p) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après l'aube.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tzeit",
            "in": "query",
            "required": false,
            "description": "Code proposé (7.08, 8.5, 13.5p, 18f, 20f) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après la shqi'a.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fin",
            "in": "query",
            "required": false,
            "description": "Code proposé (8.5, 7.08, min, rt) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après la shqi'a ; aussi « rt » et « min ».",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rt",
            "in": "query",
            "required": false,
            "description": "Code proposé (16.1, 72p, 72f) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après la shqi'a.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "finMinutes",
            "in": "query",
            "required": false,
            "description": "Minutes après la shqi'a si fin = min.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "plag",
            "in": "query",
            "required": false,
            "description": "Plag hamin'ha.",
            "schema": {
              "type": "string",
              "enum": [
                "gra",
                "ma",
                "yy"
              ]
            }
          },
          {
            "name": "bougies",
            "in": "query",
            "required": false,
            "description": "Minutes d'allumage.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "israel",
            "in": "query",
            "required": false,
            "description": "Calendrier d'Israël.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "zmanim",
            "in": "query",
            "required": false,
            "description": "Liste séparée par des virgules.",
            "schema": {
              "type": "string"
            },
            "example": "netz,shqia,tzeit"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Format des heures.",
            "schema": {
              "type": "string",
              "enum": [
                "hhmm",
                "iso",
                "ms"
              ]
            }
          },
          {
            "name": "arrondi",
            "in": "query",
            "required": false,
            "description": "Arrondi.",
            "schema": {
              "type": "string",
              "enum": [
                "calj",
                "proche",
                "aucun"
              ]
            }
          },
          {
            "name": "langue",
            "in": "query",
            "required": false,
            "description": "Langue des noms.",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "en",
                "he"
              ]
            }
          },
          {
            "name": "calendrier",
            "in": "query",
            "required": false,
            "description": "Date hébraïque, fêtes, paracha, événements.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "tefila",
            "in": "query",
            "required": false,
            "description": "Ajouts de la tefila.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "nusach",
            "in": "query",
            "required": false,
            "description": "Nousa'h.",
            "schema": {
              "type": "string",
              "enum": [
                "sefarade",
                "ashkenaze",
                "sfard"
              ]
            }
          },
          {
            "name": "ajouts",
            "in": "query",
            "required": false,
            "description": "JSON : { nom: { ref, minutes | proportionnelles, arrondi } | { angle, moment } }.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offices",
            "in": "query",
            "required": false,
            "description": "JSON : liste d'offices.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Horaires"
          },
          "400": {
            "$ref": "#/components/responses/Erreur"
          }
        }
      },
      "post": {
        "tags": [
          "Horaires"
        ],
        "operationId": "horairesPost",
        "summary": "Horaires, options en JSON",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Options de calcul. Seul le lieu est obligatoire (lieu, ou lat et lon).",
                "properties": {
                  "lieu": {
                    "description": "Nom de ville (français, anglais ou hébreu, sans accents ni majuscules ; un début de nom sans ambiguïté suffit), « lat,lon », ou objet.",
                    "oneOf": [
                      {
                        "type": "string",
                        "examples": [
                          "Paris",
                          "charenton",
                          "48.85,2.35"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "nom": {
                            "type": "string"
                          },
                          "lat": {
                            "type": "number"
                          },
                          "lon": {
                            "type": "number"
                          },
                          "tz": {
                            "type": "string"
                          },
                          "bougies": {
                            "type": "number"
                          },
                          "israel": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "lat",
                          "lon"
                        ]
                      }
                    ]
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "tz": {
                    "type": "string",
                    "description": "Fuseau IANA. Par défaut celui de la ville, ou de la ville connue la plus proche (25 km).",
                    "examples": [
                      "Europe/Paris"
                    ]
                  },
                  "bougies": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 120,
                    "description": "Minutes d'allumage avant la shqi'a (18 par défaut, 40 à Jérusalem…)."
                  },
                  "israel": {
                    "type": "boolean",
                    "description": "Calendrier d'Israël (un jour de fête, paracha d'Israël). Par défaut selon le pays."
                  },
                  "joursIsrael": {
                    "type": "boolean",
                    "description": "Jours nationaux israéliens."
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "description": "AAAA-MM-JJ (1900 à 2239). Par défaut : aujourd'hui dans le fuseau du lieu."
                  },
                  "jours": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 366,
                    "default": 1
                  },
                  "minhag": {
                    "type": "string",
                    "enum": [
                      "ormeir",
                      "ovadia",
                      "standard"
                    ],
                    "default": "ormeir"
                  },
                  "alot": {
                    "type": "string",
                    "description": "Code proposé (16.1, 72p, 90p, 72f, 19.8) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») avant le netz.",
                    "examples": [
                      "16.1"
                    ]
                  },
                  "misheyakir": {
                    "type": "string",
                    "description": "Code proposé (11, 11.5, 10.2, 6p) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après l'aube.",
                    "examples": [
                      "11"
                    ]
                  },
                  "tzeit": {
                    "type": "string",
                    "description": "Code proposé (7.08, 8.5, 13.5p, 18f, 20f) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après la shqi'a.",
                    "examples": [
                      "7.08"
                    ]
                  },
                  "fin": {
                    "type": "string",
                    "description": "Code proposé (8.5, 7.08, min, rt) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après la shqi'a ; aussi « rt » et « min ».",
                    "examples": [
                      "8.5"
                    ]
                  },
                  "finMinutes": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 240,
                    "description": "Minutes après la shqi'a si fin = min."
                  },
                  "rt": {
                    "type": "string",
                    "description": "Code proposé (16.1, 72p, 72f) ou avis libre : degrés sous l'horizon (« 18 »), minutes proportionnelles (« 120p ») ou fixes (« 45f ») après la shqi'a.",
                    "examples": [
                      "16.1"
                    ]
                  },
                  "plag": {
                    "type": "string",
                    "enum": [
                      "gra",
                      "ma",
                      "yy"
                    ]
                  },
                  "avis": {
                    "type": "object",
                    "description": "Les mêmes avis, groupés.",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "zmanim": {
                    "description": "Zmanim à renvoyer (tous par défaut).",
                    "oneOf": [
                      {
                        "type": "string",
                        "examples": [
                          "netz,shqia,tzeit"
                        ]
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "alot",
                            "tefilin",
                            "netz",
                            "shemaMA",
                            "shemaGRA",
                            "tefilaMA",
                            "tefila",
                            "hatsot",
                            "minhaGuedola",
                            "minhaKetana",
                            "plag",
                            "bougies",
                            "shqia",
                            "tzeit",
                            "finShabbat",
                            "rabenouTam"
                          ]
                        }
                      }
                    ]
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "hhmm",
                      "iso",
                      "ms"
                    ],
                    "default": "hhmm"
                  },
                  "arrondi": {
                    "type": "string",
                    "enum": [
                      "calj",
                      "proche",
                      "aucun"
                    ],
                    "default": "calj",
                    "description": "calj : minute inférieure, fin de Shabbat à la minute supérieure."
                  },
                  "langue": {
                    "type": "string",
                    "enum": [
                      "fr",
                      "en",
                      "he"
                    ],
                    "default": "fr"
                  },
                  "calendrier": {
                    "type": "boolean",
                    "default": true
                  },
                  "tefila": {
                    "type": "boolean",
                    "default": false
                  },
                  "nusach": {
                    "type": "string",
                    "enum": [
                      "sefarade",
                      "ashkenaze",
                      "sfard"
                    ]
                  },
                  "ajouts": {
                    "type": "object",
                    "description": "Vos propres zmanim, par nom.",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/Ajout"
                    }
                  },
                  "offices": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Office"
                    }
                  }
                }
              },
              "examples": {
                "shabbat": {
                  "summary": "Shabbat à Marseille, Rav Ovadia",
                  "value": {
                    "lieu": "Marseille",
                    "date": "2026-11-13",
                    "jours": 2,
                    "minhag": "ovadia",
                    "zmanim": [
                      "bougies",
                      "finShabbat",
                      "rabenouTam"
                    ]
                  }
                },
                "communaute": {
                  "summary": "Offices et zmanim ajoutés",
                  "value": {
                    "lieu": "Charenton",
                    "date": "2026-11-14",
                    "ajouts": {
                      "korbanot": {
                        "ref": "netz",
                        "proportionnelles": -90
                      }
                    },
                    "offices": [
                      {
                        "nom": "Cha'harit",
                        "jours": [
                          6
                        ],
                        "heure": "09:00"
                      },
                      {
                        "nom": "Min'ha",
                        "ref": "shqia",
                        "decalage": -15,
                        "arrondi": "bas5"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Horaires"
          },
          "400": {
            "$ref": "#/components/responses/Erreur"
          }
        }
      }
    },
    "/villes": {
      "get": {
        "tags": [
          "Catalogues"
        ],
        "operationId": "villes",
        "summary": "Villes connues",
        "parameters": [
          {
            "name": "langue",
            "in": "query",
            "required": false,
            "description": "Langue des noms.",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "en",
                "he"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des villes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ville"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/avis": {
      "get": {
        "tags": [
          "Catalogues"
        ],
        "operationId": "avis",
        "summary": "Avis et minhagim disponibles",
        "parameters": [
          {
            "name": "langue",
            "in": "query",
            "required": false,
            "description": "Langue des libellés.",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "en",
                "he"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalogue"
                }
              }
            }
          }
        }
      }
    },
    "/api": {
      "get": {
        "tags": [
          "Catalogues"
        ],
        "operationId": "aide",
        "summary": "Aide courte",
        "responses": {
          "200": {
            "description": "Routes et exemple"
          }
        }
      }
    }
  },
